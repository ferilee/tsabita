---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  showMobileNav?: boolean;
}

const {
  title = 'Nama Anda — karya, cerita, dan catatan',
  description = 'Portofolio pribadi dan jurnal digital tentang karya, cerita, opini, dan perjalanan.',
  noindex = false,
  showMobileNav = true
} = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body class={showMobileNav ? 'has-mobile-nav' : undefined}>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Kembali ke beranda">tsabita<span>.</span><b>♡</b></a>
        <nav aria-label="Navigasi utama">
          <a href="/">Home</a>
          <a href="/tentang">About</a>
          <a href="/karya">Work</a>
          <a href="/#services">Services</a>
          <a href="/blog">Journal</a>
          <a href="/kontak">Contact</a>
          <a class="nav-contact" href="/kontak">Let's Connect <span>↗</span></a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {showMobileNav && <nav class="mobile-bottom-nav" aria-label="Navigasi mobile">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="mobile-nav-icon">⌂</span><span>Home</span></a>
      <a href="/tentang" aria-current={isCurrent('/tentang') ? 'page' : undefined}><span class="mobile-nav-icon">✿</span><span>About</span></a>
      <a href="/karya" aria-current={isCurrent('/karya') ? 'page' : undefined}><span class="mobile-nav-icon">✦</span><span>Work</span></a>
      <a href="/blog" aria-current={isCurrent('/blog') ? 'page' : undefined}><span class="mobile-nav-icon">☷</span><span>Journal</span></a>
      <a href="/kontak" aria-current={isCurrent('/kontak') ? 'page' : undefined}><span class="mobile-nav-icon">♡</span><span>Contact</span></a>
    </nav>}
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} Nama Anda</p>
        <p>Dibuat dengan rasa ingin tahu <span class="footer-heart">♡</span></p>
        <div class="footer-links">
          <a href="https://www.linkedin.com" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com" rel="noreferrer">GitHub</a>
          <a href="mailto:halo@example.com">Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
