---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  showMobileNav?: boolean;
  mobileNav?: 'public' | 'admin';
}

const {
  title = 'Tsabita Dianyssa Estasaadya — perjalanan bioteknologi',
  description = 'Catatan perjalanan hidup dan kuliah Tsabita Dianyssa Estasaadya, mahasiswa Bioteknologi Universitas Negeri Malang.',
  noindex = false,
  showMobileNav = true,
  mobileNav = 'public'
} = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
const isAdminCurrent = (path: string) => path === '/admin'
  ? pathname === '/admin' || pathname === '/admin/'
  : pathname.startsWith(path);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body class={showMobileNav ? 'has-mobile-nav' : undefined}>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Kembali ke beranda">tsabita<span>.</span><b>♡</b></a>
        <nav aria-label="Navigasi utama">
          <a href="/">Home</a>
          <a href="/tentang">Tentang</a>
          <a href="/karya">Karya</a>
          <a href="/#journey">Perjalanan</a>
          <a href="/blog">Jurnal</a>
          <a href="/kontak">Kontak</a>
          <a class="nav-contact" href="/kontak">Mari terhubung <span>↗</span></a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {showMobileNav && <nav class="mobile-bottom-nav" aria-label={mobileNav === 'admin' ? 'Navigasi admin mobile' : 'Navigasi mobile'}>
      {mobileNav === 'admin' ? <>
        <a href="/admin" aria-current={isAdminCurrent('/admin') ? 'page' : undefined}><span class="mobile-nav-icon">⌂</span><span>Dashboard</span></a>
        <a href="/admin/tulisan" aria-current={isAdminCurrent('/admin/tulisan') ? 'page' : undefined}><span class="mobile-nav-icon">✎</span><span>Tulisan</span></a>
        <a href="/admin/karya" aria-current={isAdminCurrent('/admin/karya') ? 'page' : undefined}><span class="mobile-nav-icon">✦</span><span>Karya</span></a>
        <a href="/admin/inbox" aria-current={isAdminCurrent('/admin/inbox') ? 'page' : undefined}><span class="mobile-nav-icon">✉</span><span>Inbox</span></a>
        <a href="/"><span class="mobile-nav-icon">↗</span><span>Website</span></a>
      </> : <>
        <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}><span class="mobile-nav-icon">⌂</span><span>Home</span></a>
        <a href="/tentang" aria-current={isCurrent('/tentang') ? 'page' : undefined}><span class="mobile-nav-icon">✿</span><span>Tentang</span></a>
        <a href="/karya" aria-current={isCurrent('/karya') ? 'page' : undefined}><span class="mobile-nav-icon">✦</span><span>Karya</span></a>
        <a href="/blog" aria-current={isCurrent('/blog') ? 'page' : undefined}><span class="mobile-nav-icon">☷</span><span>Jurnal</span></a>
        <a href="/kontak" aria-current={isCurrent('/kontak') ? 'page' : undefined}><span class="mobile-nav-icon">♡</span><span>Kontak</span></a>
      </>}
    </nav>}
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} Tsabita Dianyssa Estasaadya</p>
        <p>Belajar, bertumbuh, dan mencatat <span class="footer-heart">♡</span></p>
        <div class="footer-links">
          <a href="https://www.linkedin.com" rel="noreferrer">LinkedIn</a>
          <a href="https://www.instagram.com/esthesadya/" rel="noreferrer">Instagram</a>
          <a href="mailto:tsabita@example.com">Email</a>
          {mobileNav === 'public' && <button class="admin-access" type="button" data-admin-modal-open>Akses admin</button>}
        </div>
      </div>
    </footer>
    {mobileNav === 'public' && <dialog class="admin-access-modal" data-admin-modal>
      <div class="admin-modal-content">
        <button class="admin-modal-close" type="button" data-admin-modal-close aria-label="Tutup akses admin">×</button>
        <p class="eyebrow">Ruang kerja</p>
        <h2>Masuk ke dashboard</h2>
        <p class="muted">Gunakan token admin untuk mengelola tulisan, karya, dan pesan masuk.</p>
        <form class="admin-form" data-public-login-form>
          <label>Admin token<input name="token" type="password" autocomplete="current-password" required /></label>
          <button class="button" type="submit">Masuk <span>↗</span></button>
          <p class="form-status" data-public-login-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </dialog>}
  </body>
</html>

<script src="../scripts/admin-access.ts"></script>
<script src="../scripts/motion.ts"></script>
