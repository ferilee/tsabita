---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectEntries } from '../../lib/content';

const projects = (await getProjectEntries()).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Karya dan catatan — Tsabita">
  <section class="page-intro shell">
    <p class="eyebrow">02 / Karya dan catatan</p>
    <h1>Hal-hal yang<br /><em>sedang saya pelajari.</em></h1>
    <p class="page-lede">Dokumentasi praktikum, proyek kuliah, eksperimen kecil, dan cerita visual dari perjalanan saya sebagai mahasiswa bioteknologi.</p>
  </section>
  <section class="section shell compact-top">
    <div class="project-grid project-grid-all">
      {projects.map((project, index) => (
        <a class="project-card" href={`/karya/${project.id}`}>
          <div class="project-image" style={`--card-color: ${project.data.cover}`}>
            <span class="project-number">0{index + 1}</span><span class="project-mark">✳</span>
          </div>
          <div class="project-meta"><div><h3>{project.data.title}</h3><p>{project.data.summary}</p></div><span class="year">{project.data.year}</span></div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
