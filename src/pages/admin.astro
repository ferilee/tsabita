---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout>
  <section class="admin-overview">
    <div class="section-heading admin-section-heading">
      <div><p class="eyebrow">Ringkasan</p><h2>Halo, Tsabita <span>♡</span></h2></div>
      <p class="muted">Kelola cerita dan karya dari satu tempat.</p>
    </div>

    <div class="admin-stat-grid">
      <a class="admin-stat" href="/admin/tulisan"><span class="admin-stat-icon">✎</span><span><small>Total tulisan</small><strong data-post-count>0</strong></span><b>↗</b></a>
      <a class="admin-stat" href="/admin/karya"><span class="admin-stat-icon">✦</span><span><small>Total karya</small><strong data-project-count>0</strong></span><b>↗</b></a>
      <a class="admin-stat" href="/admin/inbox"><span class="admin-stat-icon">✉</span><span><small>Pesan masuk</small><strong data-message-count>0</strong></span><b>↗</b></a>
      <div class="admin-stat"><span class="admin-stat-icon">♡</span><span><small>Belum dibaca</small><strong data-unread-count>0</strong></span></div>
    </div>

    <div class="admin-quick-actions">
      <p class="eyebrow">Aksi cepat</p>
      <div><a class="button" href="/admin/tulisan">Tulis artikel <span>↗</span></a><a class="outline-button" href="/admin/karya">Tambah karya <span>↗</span></a></div>
    </div>

    <section class="admin-card admin-profile-card">
      <div class="card-heading"><div><p class="eyebrow">Profil</p><h2>Foto di halaman tentang</h2></div></div>
      <div class="about-image-editor">
        <div class="about-image-preview" data-about-preview><span data-about-placeholder aria-hidden="true">✳</span><img data-about-image alt="Preview foto Tsabita" hidden /></div>
        <form class="admin-form" data-about-form>
          <label>Ganti gambar<input name="image" type="file" accept="image/jpeg,image/png,image/webp" required /></label>
          <small class="upload-help">JPG, PNG, atau WebP. Ukuran maksimal 5 MB.</small>
          <button class="button" type="submit">Simpan gambar <span>↗</span></button>
          <p class="form-status" data-about-status role="status"></p>
        </form>
      </div>
    </section>

    <div class="admin-content-status">
      <p class="eyebrow">Status konten</p>
      <div><span><strong data-published-count>0</strong> tulisan terbit</span><span><strong data-draft-count>0</strong> tulisan draft</span></div>
    </div>

    <div class="admin-overview-grid">
      <section class="admin-card">
        <div class="card-heading"><div><p class="eyebrow">Terbaru</p><h2>Tulisan terakhir</h2></div><a class="plain-button" href="/admin/tulisan">Lihat semua →</a></div>
        <div class="admin-list" data-latest-posts></div>
      </section>
      <section class="admin-card">
        <div class="card-heading"><div><p class="eyebrow">Terbaru</p><h2>Karya terakhir</h2></div><a class="plain-button" href="/admin/karya">Lihat semua →</a></div>
        <div class="admin-list" data-latest-projects></div>
      </section>
    </div>

    <section class="admin-card admin-recent-messages">
      <div class="card-heading"><div><p class="eyebrow">Inbox</p><h2>Pesan terbaru</h2></div><a class="plain-button" href="/admin/inbox">Buka inbox →</a></div>
      <div class="admin-list" data-recent-messages></div>
    </section>
  </section>
</AdminLayout>
