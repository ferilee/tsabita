---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Inbox — Admin Tsabita" heading="inbox.">
  <section class="admin-card">
    <div class="card-heading"><div><p class="eyebrow">Pesan dari pengunjung</p><h2>Inbox</h2></div><span class="count" data-message-count>0</span></div>
    <p class="muted inbox-intro">Tandai pesan sebagai sudah dibaca setelah menindaklanjutinya.</p>
    <div class="admin-list" data-messages-list></div>
  </section>
</AdminLayout>
