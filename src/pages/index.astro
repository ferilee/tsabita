---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogEntries, getProjectEntries } from '../lib/content';

const projects = (await getProjectEntries())
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.year - a.data.year);
const posts = (await getBlogEntries())
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const formatDate = (date: Date) => date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-kicker"><span class="status-dot"></span> Terbuka untuk kolaborasi</div>
    <h1>Saya membuat<br /><em>hal-hal yang berarti.</em></h1>
    <div class="hero-bottom">
      <p class="hero-intro">Perancang dan pembuat pengalaman digital. Di sini saya menyimpan karya, cerita, opini, dan potongan perjalanan.</p>
      <a class="arrow-link" href="/tentang">Kenali saya <span>↗</span></a>
    </div>
  </section>

  <section class="section shell" aria-labelledby="works-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Pilihan karya</p>
        <h2 id="works-heading">Yang sedang saya bangun</h2>
      </div>
      <a class="text-link" href="/karya">Lihat semua karya <span>↗</span></a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <a class="project-card" href={`/karya/${project.id}`}>
          <div class="project-image" style={`--card-color: ${project.data.cover}`}>
            <span class="project-number">0{projects.indexOf(project) + 1}</span>
            <span class="project-mark">✳</span>
          </div>
          <div class="project-meta">
            <div><h3>{project.data.title}</h3><p>{project.data.summary}</p></div>
            <span class="year">{project.data.year}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section journal-section" aria-labelledby="journal-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Jurnal</p>
          <h2 id="journal-heading">Catatan dari perjalanan</h2>
        </div>
        <a class="text-link" href="/blog">Buka blog <span>↗</span></a>
      </div>
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}`}>
            <div class="post-date">{formatDate(post.data.publishedAt)}</div>
            <div class="post-content"><span class="tag">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
            <span class="row-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta shell">
    <p class="eyebrow">03 / Kontak</p>
    <h2>Punya ide yang ingin<br /><em>diwujudkan bersama?</em></h2>
    <a class="button" href="/kontak">Mari ngobrol <span>↗</span></a>
  </section>
</BaseLayout>
